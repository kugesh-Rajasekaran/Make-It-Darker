{
  "manifest_version": 3,
  "name": "Make It Darker",
  "version": "0.1.0",
  "description": "Dark mode for every website that never hides a button or a line of text. Already-dark pages are left alone.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Make It Darker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "dark.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "css_origin": "user"
    }
  ]
}
