{
  "name": "make-it-darker",
  "version": "0.1.0",
  "private": true,
  "description": "Dark mode for every website, in Dia, any Chromium browser and Safari, that never hides a button or a line of text",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "e2e": "node test/live/e2e.mjs",
    "icons": "python3 scripts/make-icons.py",
    "package": "cd extension && zip -qr ../make-it-darker.zip . -x '.*'",
    "safari": "sh scripts/make-safari.sh"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "pngjs": "7.0.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
